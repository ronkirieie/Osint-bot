# Required
# Use either name. TELEGRAM_TOKEN takes priority if both are set.
TELEGRAM_TOKEN=
BOT_TOKEN=
OWNER_ID=

# Optional bot/API configuration
BOT_USERNAME=YourOsintBot
PAID_API_BASE=https://paid-apis.vercel.app/api
# Preferred: one key per lookup service
# Put each complete authenticated URL in Railway Variables.
# Do not commit real keys to GitHub.
NUMBER_API_URL=https://numinfotitan.vercel.app/search?key=YOUR_NUMBER_KEY&num=0
NUMBER_API_PARAM=num
NUMBER_API_KEY_PARAM=key
AADHAR_API_URL=https://paid-apis.vercel.app/api/aadhar?number=0&api_key=YOUR_AADHAR_KEY
VEHICLE_API_URL=https://paid-apis.vercel.app/api/vehicle?number=HR26EV0001&api_key=YOUR_VEHICLE_KEY
IFSC_API_URL=https://paid-apis.vercel.app/api/ifsc?ifsc=SBIN0001234&api_key=YOUR_IFSC_KEY
GST_API_URL=https://paid-apis.vercel.app/api/gst?gstin=29AACCF0683K1ZD&api_key=YOUR_GST_KEY

# Optional separate-key fallback when a URL does not contain its key
NUMBER_API_KEY=
AADHAR_API_KEY=
VEHICLE_API_KEY=
IFSC_API_KEY=
GST_API_KEY=

# Optional legacy fallback if all services share one key
PAID_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Railway PostgreSQL supplies this when the database is linked.
# Leave it unset for local SQLite fallback.
DATABASE_URL=